<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
    Дашборд: список команд користувача, створення нової, вихід.
    Контролер: DashboardController.
-->

<BorderPane styleClass="dashboard-container" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="ua.uzhnu.collab.controller.DashboardController">

    <!-- Верхня панель -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="toolbar">
            <padding><Insets bottom="12" left="16" right="16" top="12" /></padding>
            <Label fx:id="lblWelcome" styleClass="welcome-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Оновити" />
            <Button onAction="#showSetting" styleClass="btn-secondary" text="Налаштування" />
            <Button onAction="#showAccaunt" styleClass="btn-secondary" text="Профіль" />
            <Button onAction="#handleLogout" styleClass="btn-danger" text="Вийти" />
        </HBox>
    </top>

    <!-- Центр: список команд -->
    <center>
        <VBox spacing="12" styleClass="content-area">
            <padding><Insets bottom="16" left="24" right="24" top="16" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="section-title" text="Мої команди" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTeamCount" styleClass="stats-label" text="Команд: 0" />
                <Button onAction="#handleCreateTeam" styleClass="btn-primary" text="+ Створити команду" />
            </HBox>

            <ListView fx:id="listTeams" styleClass="team-list" VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER">
                <ProgressIndicator fx:id="spinner" prefHeight="36" prefWidth="36" visible="false" />
            </HBox>

            <Button maxWidth="Infinity" onAction="#handleOpenTeam" styleClass="btn-primary" text="Відкрити команду" />
        </VBox>
    </center>
</BorderPane>
