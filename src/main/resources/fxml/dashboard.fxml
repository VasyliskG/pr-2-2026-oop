<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    Дашборд: список команд користувача, створення нової, вихід.
    Контролер: DashboardController.
-->

<BorderPane styleClass="dashboard-container" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="ua.uzhnu.collab.controller.DashboardController">

    <fx:define>
        <ToggleGroup fx:id="calendarModeGroup" />
    </fx:define>

    <!-- Верхня панель -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="toolbar">
            <padding><Insets bottom="12" left="16" right="16" top="12" /></padding>
            <Label fx:id="lblWelcome" styleClass="welcome-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Оновити" />
            <Button onAction="#showSetting" styleClass="btn-secondary" text="Налаштування" />
            <Button onAction="#showAccaunt" styleClass="btn-secondary" text="Профіль" />
            <Button onAction="#handleLogout" styleClass="btn-danger" text="Вийти" />
        </HBox>
    </top>

    <!-- Центр: список команд -->
    <center>
        <VBox spacing="12" styleClass="content-area">
            <padding><Insets bottom="16" left="24" right="24" top="16" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="section-title" text="Мої команди" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTeamCount" styleClass="stats-label" text="Команд: 0" />
                <Button onAction="#handleCreateTeam" styleClass="btn-primary" text="+ Створити команду" />
            </HBox>

            <ListView fx:id="listTeams" styleClass="team-list" VBox.vgrow="ALWAYS" />

            <!-- Глобальний календар дедлайнів -->
            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="section-subtitle" text="Календар дедлайнів" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#handleCalendarPrevious" styleClass="btn-secondary" text="←" />
                    <Button onAction="#handleCalendarToday" styleClass="btn-secondary" text="Сьогодні" />
                    <DatePicker fx:id="dpGlobalCalendar" />
                    <Button onAction="#handleCalendarNext" styleClass="btn-secondary" text="→" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="stats-label" text="Режим:" />
                    <ToggleButton fx:id="btnCalendarMonth" selected="true" styleClass="calendar-mode-toggle" text="Місяць" toggleGroup="$calendarModeGroup" />
                    <ToggleButton fx:id="btnCalendarWeek" styleClass="calendar-mode-toggle" text="Тиждень" toggleGroup="$calendarModeGroup" />
                    <ToggleButton fx:id="btnCalendarList" styleClass="calendar-mode-toggle" text="Список" toggleGroup="$calendarModeGroup" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblCalendarRange" styleClass="stats-label" />
                </HBox>

                <StackPane VBox.vgrow="ALWAYS">
                    <ScrollPane fx:id="spCalendarMonth" fitToHeight="true" fitToWidth="true" pannable="true">
                        <content>
                            <GridPane fx:id="paneCalendarMonth" />
                        </content>
                    </ScrollPane>
                    <ScrollPane fx:id="spCalendarWeek" fitToHeight="true" fitToWidth="true" pannable="true" visible="false" managed="false">
                        <content>
                            <GridPane fx:id="paneCalendarWeek" />
                        </content>
                    </ScrollPane>
                    <ListView fx:id="listCalendarGlobal" visible="false" managed="false" VBox.vgrow="ALWAYS" />
                </StackPane>
            </VBox>

            <HBox alignment="CENTER">
                <ProgressIndicator fx:id="spinner" prefHeight="36" prefWidth="36" visible="false" />
            </HBox>

            <Button maxWidth="Infinity" onAction="#handleOpenTeam" styleClass="btn-primary" text="Відкрити команду" />
        </VBox>
    </center>
</BorderPane>
