<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Екран команди: канбан-дошка задач, чат, файли, учасники (TabPane).
    Контролер: TeamViewController.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ua.uzhnu.collab.controller.TeamViewController"
            styleClass="team-container">

    <!-- Верхня панель -->
    <top>
        <VBox styleClass="toolbar">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="10" right="16" bottom="6" left="16"/></padding>
                <Button text="← Назад" onAction="#handleBack" styleClass="btn-secondary"/>
                <Label fx:id="lblTeamName" styleClass="team-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Оновити" onAction="#handleRefresh" styleClass="btn-secondary"/>
                <ProgressIndicator fx:id="spinner" visible="false" prefWidth="24" prefHeight="24"/>
            </HBox>
            <Label fx:id="lblStats" styleClass="stats-bar">
                <padding><Insets top="0" right="16" bottom="8" left="16"/></padding>
            </Label>
        </VBox>
    </top>

    <!-- Центр: вкладки -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs">

            <!-- ============= Вкладка 1: Задачі (канбан) ============= -->
            <Tab text="Задачі">
                <VBox spacing="8">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <!-- Панель пошуку та створення -->
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <TextField fx:id="txtTaskSearch" promptText="Пошук задач..."
                                   HBox.hgrow="ALWAYS" styleClass="search-field"/>
                        <Button text="+ Нова задача" onAction="#handleCreateTask"
                                styleClass="btn-primary"/>
                    </HBox>

                    <!-- Три колонки канбану -->
                    <HBox spacing="12" VBox.vgrow="ALWAYS">
                        <!-- TODO -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="kanban-column">
                            <Label text="TODO" styleClass="kanban-header todo-header"/>
                            <ListView fx:id="listTodo" VBox.vgrow="ALWAYS"/>
                        </VBox>

                        <!-- IN PROGRESS -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="kanban-column">
                            <Label text="В РОБОТІ" styleClass="kanban-header progress-header"/>
                            <ListView fx:id="listInProgress" VBox.vgrow="ALWAYS"/>
                        </VBox>

                        <!-- DONE -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="kanban-column">
                            <Label text="ВИКОНАНО" styleClass="kanban-header done-header"/>
                            <ListView fx:id="listDone" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ============= Вкладка 2: Чат ============= -->
            <Tab text="Чат">
                <VBox spacing="8">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>

                    <ListView fx:id="listChat" VBox.vgrow="ALWAYS" styleClass="chat-list"/>

                    <HBox spacing="8">
                        <TextField fx:id="txtChatInput" promptText="Написати повідомлення..."
                                   HBox.hgrow="ALWAYS" styleClass="chat-input"/>
                        <Button text="Надіслати" onAction="#handleSendMessage"
                                styleClass="btn-primary"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ============= Вкладка 3: Файли ============= -->
            <Tab text="Файли">
                <VBox spacing="8">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Файли команди" styleClass="section-title"/>
                    <ListView fx:id="listFiles" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>

            <!-- ============= Вкладка 4: Учасники ============= -->
            <Tab text="Учасники">
                <VBox spacing="8">
                    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                    <Label text="Учасники команди" styleClass="section-title"/>
                    <ListView fx:id="listMembers" VBox.vgrow="ALWAYS"/>
                </VBox>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
