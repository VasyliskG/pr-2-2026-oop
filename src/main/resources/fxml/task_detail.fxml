<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Діалог детального перегляду/редагування задачі.
    Контролер: TaskDetailController.
    Улучшено: современный стиль, улучшенная визуальная иерархия, интерактивные элементы.
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ua.uzhnu.collab.controller.TaskDetailController"
            prefWidth="800" prefHeight="650" styleClass="task-detail">

    <!-- Заголовок с современным дизайном -->
    <top>
        <VBox styleClass="task-detail-header" spacing="0">
            <!-- Режим перегляду -->
            <VBox fx:id="viewPane" spacing="12">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

                <!-- Рядок з назвою та кнопкою редагування -->
                <HBox alignment="CENTER_LEFT" spacing="16">
                    <Label fx:id="lblTitle" styleClass="task-detail-title" wrapText="true" maxWidth="500"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="✎ Редагувати" onAction="#handleToggleEdit"
                            styleClass="btn-secondary" style="-fx-font-size: 12px;"/>
                </HBox>

                <!-- Метаінформація: статус, пріоритет, дедлайн -->
                <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-wrap-text: true;">
                    <HBox spacing="8" alignment="CENTER_LEFT" style="-fx-border-color: transparent transparent #f0f0f0 transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 12 0;">
                        <Label fx:id="lblStatus" styleClass="status-badge"/>
                        <Label fx:id="lblPriority" styleClass="priority-badge"/>
                        <Separator orientation="VERTICAL" style="-fx-padding: 0 2 0 2; -fx-text-fill: #e0e0e0;"/>
                        <Label fx:id="lblDueDate" styleClass="metadata-label"/>
                        <Label fx:id="lblOverdue" styleClass="overdue-badge"/>
                    </HBox>
                </HBox>

                <!-- Інформація про створювача -->
                <Label fx:id="lblCreator" styleClass="creator-info" wrapText="true"/>
            </VBox>

            <!-- Режим редагування -->
            <VBox fx:id="editPane" spacing="12" visible="false" managed="false">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

                <!-- Редагування назви -->
                <VBox spacing="4">
                    <Label text="Назва задачі:" styleClass="edit-label"/>
                    <TextField fx:id="txtEditTitle" promptText="Введіть назву задачі..."
                               styleClass="input-field" style="-fx-font-size: 13px;"/>
                </VBox>

                <!-- Статус, пріоритет, дедлайн -->
                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Статус:" styleClass="edit-label"/>
                        <ComboBox fx:id="cbEditStatus" styleClass="combo-box"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Пріоритет:" styleClass="edit-label"/>
                        <ComboBox fx:id="cbEditPriority" styleClass="combo-box"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Дедлайн:" styleClass="edit-label"/>
                        <DatePicker fx:id="dpEditDueDate" styleClass="date-picker"/>
                    </VBox>
                </HBox>

                <!-- Час дедлайну -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Час:" styleClass="edit-label" style="-fx-min-width: 50;"/>
                    <TextField fx:id="txtEditDueTime" promptText="HH:mm"
                               styleClass="input-field" style="-fx-font-size: 13px; -fx-pref-width: 80;"/>
                    <Button text="✕ Очистити дедлайн" onAction="#handleClearDueDate"
                            styleClass="btn-secondary" style="-fx-font-size: 11px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Кнопки дії -->
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <Button text="✓ Зберегти" onAction="#handleSaveEdit" styleClass="btn-primary"/>
                    <Button text="✕ Скасувати" onAction="#handleCancelEdit" styleClass="btn-secondary"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <!-- Основний вміст -->
    <center>
        <SplitPane dividerPositions="0.50" orientation="VERTICAL" style="-fx-border-color: transparent;">

            <!-- Верхня частина: опис + виконавці -->
            <VBox spacing="16" style="-fx-padding: 16 20 16 20;">

                <!-- Секція: Опис -->
                <VBox spacing="8" styleClass="task-section">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="📝 Опис" styleClass="section-title-modern"/>
                        <Separator HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <TextArea fx:id="txtDescription" wrapText="true" editable="false"
                              VBox.vgrow="ALWAYS" prefRowCount="3" styleClass="description-area"
                              style="-fx-font-size: 13px; -fx-padding: 10 12; -fx-control-inner-background: #fafafa;"/>
                </VBox>

                <!-- Секція: Виконавці -->
                <VBox spacing="8" styleClass="task-section">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="👥 Виконавці" styleClass="section-title-modern"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Додати" onAction="#handleAddAssignee"
                                styleClass="btn-primary" style="-fx-font-size: 11px;"/>
                    </HBox>
                    <ListView fx:id="listAssignees" prefHeight="70" styleClass="assignees-list"
                              style="-fx-font-size: 12px;"/>
                </VBox>
            </VBox>

            <!-- Нижня частина: коментарі + файли (TabPane) -->
            <TabPane tabClosingPolicy="UNAVAILABLE" style="-fx-padding: 0 20 16 20;">

                <!-- Вкладка: Коментарі -->
                <Tab text="💬 Коментарі" closable="false">
                    <VBox spacing="12" style="-fx-padding: 12;">
                        <ListView fx:id="listComments" VBox.vgrow="ALWAYS" styleClass="comments-list"/>
                        <HBox spacing="8" style="-fx-padding: 8 0 0 0; -fx-border-color: #f0f0f0 transparent transparent transparent; -fx-border-width: 1;">
                            <TextField fx:id="txtNewComment"
                                       promptText="Додайте коментар..."
                                       HBox.hgrow="ALWAYS" styleClass="chat-input"
                                       style="-fx-font-size: 12px; -fx-padding: 10 12;"/>
                            <Button text="Додати" onAction="#handleAddComment"
                                    styleClass="btn-primary" style="-fx-font-size: 11px;"/>
                        </HBox>
                    </VBox>
                </Tab>

                <!-- Вкладка: Файли -->
                <Tab text="📎 Файли" closable="false">
                    <VBox spacing="12" style="-fx-padding: 12;">
                        <HBox spacing="8">
                            <Button text="⬆ Завантажити файл" onAction="#handleUploadFile"
                                    styleClass="btn-primary" style="-fx-font-size: 11px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <ListView fx:id="listFiles" VBox.vgrow="ALWAYS" styleClass="files-list"
                                  style="-fx-font-size: 12px;"/>
                    </VBox>
                </Tab>
            </TabPane>
        </SplitPane>
    </center>
</BorderPane>
